# A stick's physical placement, identical on the wire and in the Blender
# addon's build file (BRIDGE_PROTOCOL.md Sec 6 / Sec A.2). base/tip rather
# than a pose: a stick lattice is naturally described by its endpoints, and
# "which end goes down" is exactly the fact the grasp-offset maths needs
# (ROS2_IMPLEMENTATION_PLAN.md Sec 8.2/8.3).

string id                # Stable identifier, generated by Blender
float64[3] base          # meters, base_link -- the end that seats against the table/another stick
float64[3] tip           # meters, base_link -- the free end
float64 roll_deg         # Rotation about the stick's own axis -- matters, the stock is square
float64 length_m         # Defaults to ||tip - base|| if not otherwise constrained
float64[2] section_m     # Cross-section (x, y); defaults to the configured stock section
